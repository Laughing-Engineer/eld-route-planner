# Django & Server Config
SECRET_KEY=django-insecure-eld-route-planner-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com,.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Database Config (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/eld_planner?retryWrites=true&w=majority

# External APIs
NOMINATIM_USER_AGENT=ELDRoutePlanner/1.0 (support@eldplanner.local)
OSRM_BASE_URL=http://router.project-osrm.org
